PODSCAPE_ADMIN_PASSWORD=replace-with-a-long-unique-password
PODSCAPE_ADMIN_SECRET=replace-with-at-least-32-random-characters
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-server-only-secret-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3102
POSTGRES_URL_NON_POOLING=postgresql://user:password@host:5432/postgres

# Customer account sign-in uses only Supabase's publishable key
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
CUSTOMER_AUTH_SITE_URL=https://your-approved-deployment.example
CUSTOMER_AUTH_RECOVERY_SECRET=replace-with-32-character-random-secret
CUSTOMER_ACCOUNTS_PUBLIC=false
